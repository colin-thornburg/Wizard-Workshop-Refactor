    <!-- J: order has payment rows -->
    <Node ToolID="11">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="810" y="174" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="Round([CAPTURED_AMOUNT] - [EXPECTED_AMOUNT], 0.01)" field="VARIANCE_AMOUNT" size="18.2" type="FixedDecimal" />
            <FormulaField expression="IIF([CAPTURED_PAYMENT_COUNT] = 0, &quot;NO_PAYMENT&quot;,&#xA;  IIF(Abs([VARIANCE_AMOUNT]) &lt;= 0.01, &quot;MATCHED&quot;,&#xA;    IIF([VARIANCE_AMOUNT] &lt; 0, &quot;UNDERPAID&quot;, &quot;OVERPAID&quot;)))" field="RECONCILIATION_STATUS" size="20" type="V_WString" />
            <FormulaField expression="IIF(IsNull([LAST_CAPTURED_DATE]), Null(),&#xA;  DateTimeDiff([LAST_CAPTURED_DATE], [ORDER_DATE], &quot;days&quot;))" field="DAYS_TO_PAYMENT" size="4" type="Int32" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Matched orders: variance + status</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>

    <!-- L: order with no payment rows at all -->
    <Node ToolID="12">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="810" y="270" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="0" field="CAPTURED_AMOUNT" size="18.2" type="FixedDecimal" />
            <FormulaField expression="0" field="CAPTURED_PAYMENT_COUNT" size="4" type="Int32" />
            <FormulaField expression="0" field="FAILED_PAYMENT_COUNT" size="4" type="Int32" />
            <FormulaField expression="Null()" field="LAST_CAPTURED_DATE" size="10" type="Date" />
            <FormulaField expression="Null()" field="DAYS_TO_PAYMENT" size="4" type="Int32" />
            <FormulaField expression="Round(0 - [EXPECTED_AMOUNT], 0.01)" field="VARIANCE_AMOUNT" size="18.2" type="FixedDecimal" />
            <FormulaField expression="&quot;NO_PAYMENT&quot;" field="RECONCILIATION_STATUS" size="20" type="V_WString" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Orders without any payment</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>


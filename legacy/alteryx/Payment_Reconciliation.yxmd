    <Node ToolID="19">
      <GuiSettings Plugin="AlteryxGuiToolkit.TextBox.TextBox">
        <Position x="42" y="6" width="456" height="66" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Text>Daily Payment Reconciliation (Finance Ops) - owner: M. Ramsey

        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxJoin" />
    </Node>

    <Node ToolID="6">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="546" y="138" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="Round([ITEMS_NET] + [SHIPPING_COST], 0.01)" field="EXPECTED_AMOUNT" size="18.2" type="FixedDecimal" />
            <FormulaField expression="Uppercase(Trim([STATUS]))" field="ORDER_STATUS" size="20" type="V_WString" />
            <FormulaField expression="Uppercase(Trim([CURRENCY_CODE]))" field="CURRENCY_CODE" size="3" type="V_WString" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>EXPECTED_AMOUNT = items net + shipping (order currency)</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>

    <!-- ===================== PAYMENTS ===================== -->
    <Node ToolID="7">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="54" y="342" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="23">odbc:DSN=SNOWFLAKE_PROD;UID=SVC_ALTERYX_FIN;PWD=__EncPwd1__;Warehouse=FIN_WH;Role=FIN_ETL|||SELECT
    PAYMENT_ID,
    ORDER_ID,
    PAYMENT_METHOD,
    PAYMENT_STATUS,
    AMOUNT,
    PAYMENT_DATE
FROM RAW.SHOP.PAYMENTS</File>
          <FormatSpecificOptions>
            <PreSQL />
            <PreSQLOnConfig>True</PreSQLOnConfig>
            <NoProgress>True</NoProgress>
            <CacheData>False</CacheData>
            <TableStyle>Quoted</TableStyle>
            <ReadUncommitted>False</ReadUncommitted>
            <PostSQL />
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Payments (all statuses)</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
        <MetaInfo connection="Output">
          <RecordInfo>
            <Field name="PAYMENT_ID" source="Odbc:SNOWFLAKE_PROD" type="Int64" />
            <Field name="ORDER_ID" source="Odbc:SNOWFLAKE_PROD" type="Int64" />
            <Field name="PAYMENT_METHOD" size="16777216" source="Odbc:SNOWFLAKE_PROD" type="V_WString" />
            <Field name="PAYMENT_STATUS" size="16777216" source="Odbc:SNOWFLAKE_PROD" type="V_WString" />
            <Field name="AMOUNT" scale="2" size="18" source="Odbc:SNOWFLAKE_PROD" type="FixedDecimal" />
            <Field name="PAYMENT_DATE" source="Odbc:SNOWFLAKE_PROD" type="Date" />
          </RecordInfo>
        </MetaInfo>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>

    <Node ToolID="8">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="186" y="342" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="Uppercase(Trim([PAYMENT_STATUS]))" field="PAY_STATUS" size="20" type="V_WString" />
            <FormulaField expression="IIF([PAY_STATUS] = &quot;CAPTURED&quot;, [AMOUNT], 0)" field="CAPTURED_AMT" size="18.2" type="FixedDecimal" />
            <FormulaField expression="IIF([PAY_STATUS] = &quot;CAPTURED&quot;, 1, 0)" field="IS_CAPTURED" size="4" type="Int32" />
            <FormulaField expression="IIF([PAY_STATUS] = &quot;FAILED&quot;, 1, 0)" field="IS_FAILED" size="4" type="Int32" />
            <FormulaField expression="IIF([PAY_STATUS] = &quot;CAPTURED&quot;, [PAYMENT_DATE], Null())" field="CAPTURED_DATE" size="10" type="Date" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Flag CAPTURED / FAILED (REFUNDED ignored)</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>

    <Node ToolID="9">
      <GuiSettings Plugin="AlteryxSpatialPluginsGui.Summarize.Summarize">
        <Position x="306" y="342" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <SummarizeFields>
            <SummarizeField field="ORDER_ID" action="GroupBy" rename="ORDER_ID" />
            <SummarizeField field="CAPTURED_AMT" action="Sum" rename="CAPTURED_AMOUNT" />
            <SummarizeField field="IS_CAPTURED" action="Sum" rename="CAPTURED_PAYMENT_COUNT" />
            <SummarizeField field="IS_FAILED" action="Sum" rename="FAILED_PAYMENT_COUNT" />
            <SummarizeField field="CAPTURED_DATE" action="Max" rename="LAST_CAPTURED_DATE" />
          </SummarizeFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Payment summary per ORDER_ID</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxSpatialPluginsEngine.dll" EngineDllEntryPoint="AlteryxSummarize" />
    </Node>


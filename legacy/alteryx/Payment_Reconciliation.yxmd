  <Nodes>
    <!-- ===================== ORDERS ===================== -->
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="54" y="90" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="23">odbc:DSN=SNOWFLAKE_PROD;UID=SVC_ALTERYX_FIN;PWD=__EncPwd1__;Warehouse=FIN_WH;Role=FIN_ETL|||SELECT
    ORDER_ID,
    CUSTOMER_ID,
    ORDER_DATE,
    STATUS,
    CHANNEL,
    CURRENCY_CODE,
    SHIPPING_COST
FROM RAW.SHOP.ORDERS
WHERE UPPER(TRIM(STATUS)) &lt;&gt; 'CANCELLED'</File>
          <FormatSpecificOptions>
            <PreSQL />
            <PreSQLOnConfig>True</PreSQLOnConfig>
            <NoProgress>True</NoProgress>
            <CacheData>False</CacheData>
            <TableStyle>Quoted</TableStyle>
            <ReadUncommitted>False</ReadUncommitted>
            <PostSQL />
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Orders (excl. CANCELLED)</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
        <MetaInfo connection="Output">
          <RecordInfo>
            <Field name="ORDER_ID" source="Odbc:SNOWFLAKE_PROD" type="Int64" />
            <Field name="CUSTOMER_ID" source="Odbc:SNOWFLAKE_PROD" type="Int64" />
            <Field name="ORDER_DATE" source="Odbc:SNOWFLAKE_PROD" type="Date" />
            <Field name="STATUS" size="16777216" source="Odbc:SNOWFLAKE_PROD" type="V_WString" />
            <Field name="CHANNEL" size="16777216" source="Odbc:SNOWFLAKE_PROD" type="V_WString" />
            <Field name="CURRENCY_CODE" size="16777216" source="Odbc:SNOWFLAKE_PROD" type="V_WString" />
            <Field name="SHIPPING_COST" scale="2" size="18" source="Odbc:SNOWFLAKE_PROD" type="FixedDecimal" />
          </RecordInfo>
        </MetaInfo>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>

    <!-- ===================== ORDER LINES ===================== -->
    <Node ToolID="2">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="54" y="210" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="23">odbc:DSN=SNOWFLAKE_PROD;UID=SVC_ALTERYX_FIN;PWD=__EncPwd1__;Warehouse=FIN_WH;Role=FIN_ETL|||SELECT
    ORDER_LINE_ID,
    ORDER_ID,
    PRODUCT_ID,
    QUANTITY,
    UNIT_PRICE,
    DISCOUNT_PCT
FROM RAW.SHOP.ORDER_LINES</File>
          <FormatSpecificOptions>
            <PreSQL />
            <PreSQLOnConfig>True</PreSQLOnConfig>
            <NoProgress>True</NoProgress>
            <CacheData>False</CacheData>
            <TableStyle>Quoted</TableStyle>
            <ReadUncommitted>False</ReadUncommitted>
            <PostSQL />
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Order lines</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
        <MetaInfo connection="Output">
          <RecordInfo>
            <Field name="ORDER_LINE_ID" source="Odbc:SNOWFLAKE_PROD" type="Int64" />
            <Field name="ORDER_ID" source="Odbc:SNOWFLAKE_PROD" type="Int64" />
            <Field name="PRODUCT_ID" source="Odbc:SNOWFLAKE_PROD" type="Int64" />
            <Field name="QUANTITY" source="Odbc:SNOWFLAKE_PROD" type="Int32" />
            <Field name="UNIT_PRICE" scale="2" size="18" source="Odbc:SNOWFLAKE_PROD" type="FixedDecimal" />
            <Field name="DISCOUNT_PCT" scale="4" size="8" source="Odbc:SNOWFLAKE_PROD" type="FixedDecimal" />
          </RecordInfo>
        </MetaInfo>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>

    <Node ToolID="3">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="186" y="210" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="[QUANTITY] * [UNIT_PRICE] - Round([QUANTITY] * [UNIT_PRICE] * [DISCOUNT_PCT], 0.01)" field="LINE_NET" size="18.2" type="FixedDecimal" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>LINE_NET = qty*price - Round(qty*price*disc, 0.01)</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>

    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxSpatialPluginsGui.Summarize.Summarize">
        <Position x="306" y="210" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <SummarizeFields>
            <SummarizeField field="ORDER_ID" action="GroupBy" rename="ORDER_ID" />
            <SummarizeField field="LINE_NET" action="Sum" rename="ITEMS_NET" />
          </SummarizeFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Items net per order</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxSpatialPluginsEngine.dll" EngineDllEntryPoint="AlteryxSummarize" />
    </Node>

    <!-- Orders + line totals: only J output is used (orders with no lines are dropped) -->
    <Node ToolID="5">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Join.Join">
        <Position x="426" y="138" />
      </GuiSettings>
      <Properties>
        <Configuration joinByRecordPos="False">
          <JoinInfo connection="Left">
            <Field field="ORDER_ID" />
          </JoinInfo>
          <JoinInfo connection="Right">
            <Field field="ORDER_ID" />
          </JoinInfo>
          <SelectConfiguration>
            <Configuration outputConnection="Join">
              <OrderChanged value="False" />
              <CommaDecimal value="False" />
              <SelectFields>
                <SelectField field="Right_ORDER_ID" selected="False" rename="Right_ORDER_ID" />
                <SelectField field="Left_CHANNEL" selected="False" />
                <SelectField field="*Unknown" selected="True" />
              </SelectFields>
            </Configuration>
          </SelectConfiguration>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>Join on ORDER_ID (J only)</DefaultAnnotationText>

    <Node ToolID="20">
      <GuiSettings Plugin="AlteryxGuiToolkit.TextBox.TextBox">
        <Position x="774" y="438" width="300" height="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Text>FIN-0912: matched tolerance = 1 cent (abs variance &lt;= 0.01).
Only CAPTURED payments count toward CAPTURED_AMOUNT. FAILED are counted, REFUNDED are ignored.
All amounts are in the order currency (no FX).</Text>
          <Font name="Arial" size="8.25" style="0" />
          <TextColor name="Black" />
          <FillColor r="204" g="229" b="255" />
          <Shape shape="0" />
          <Justification Justification="0" />
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />

  <node componentName="tSnowflakeInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="608">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tSnowflakeInput_5"/>
    <elementParameter field="TEXT" name="LABEL" value="FX_RATES (lkp)"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tSnowflakeConnection_1"/>
    <elementParameter field="TEXT" name="TABLE" value="&quot;FX_RATES&quot;"/>
    <elementParameter field="CLOSED_LIST" name="QUERYSTORE" value="BUILT_IN"/>
    <elementParameter field="CLOSED_LIST" name="MANUAL_QUERY" value="true"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT UPPER(TRIM(CURRENCY_CODE)) AS CURRENCY_CODE,&#10;       TO_CHAR(RATE_MONTH, 'YYYY-MM-DD') AS RATE_MONTH_KEY,&#10;       USD_PER_UNIT&#10;FROM &quot; + context.src_database + &quot;.&quot; + context.src_schema + &quot;.FX_RATES&quot;"/>
    <elementParameter field="CHECK" name="TRIM_ALL_COLUMN" value="false"/>
    <metadata connector="FLOW" label="tSnowflakeInput_5" name="tSnowflakeInput_5">
      <column key="true" length="255" name="CURRENCY_CODE" nullable="false" pattern="" precision="0" sourceType="VARCHAR" type="id_String" originalField="CURRENCY_CODE" usefulColumn="true"/>
      <column key="true" length="255" name="RATE_MONTH_KEY" nullable="false" pattern="" precision="0" sourceType="VARCHAR" type="id_String" originalField="RATE_MONTH_KEY" usefulColumn="true"/>
      <column key="false" length="18" name="USD_PER_UNIT" nullable="true" pattern="" precision="6" sourceType="NUMBER" type="id_BigDecimal" originalField="USD_PER_UNIT" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tMap" componentVersion="2.1" offsetLabelX="0" offsetLabelY="0" posX="320" posY="192">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1"/>
    <elementParameter field="TEXT" name="LABEL" value="MAP_RETURNS_TO_USD"/>
    <elementParameter field="EXTERNAL" name="MAP" value=""/>
    <elementParameter field="CLOSED_LIST" name="LINK_STYLE" value="AUTO"/>
    <elementParameter field="DIRECTORY" name="TEMPORARY_DATA_DIRECTORY" value=""/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <metadata connector="FLOW" label="out_returns" name="out_returns">
      <column key="false" length="38" name="ORDER_LINE_ID" nullable="true" pattern="" precision="0" sourceType="NUMBER" type="id_Long" originalField="ORDER_LINE_ID" usefulColumn="true"/>
      <column key="false" length="38" name="PRODUCT_ID" nullable="true" pattern="" precision="0" sourceType="NUMBER" type="id_Long" originalField="PRODUCT_ID" usefulColumn="true"/>
      <column key="false" length="255" name="REASON_CODE" nullable="true" pattern="" precision="0" sourceType="VARCHAR" type="id_String" originalField="REASON_CODE" usefulColumn="true"/>
      <column key="false" length="10" name="RETURN_QTY" nullable="true" pattern="" precision="0" sourceType="NUMBER" type="id_Integer" originalField="RETURN_QTY" usefulColumn="true"/>
      <column key="false" length="18" name="REFUND_USD" nullable="true" pattern="" precision="2" sourceType="NUMBER" type="id_BigDecimal" originalField="REFUND_USD" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="false">
        <mapperTableEntries name="fx_rate" expression="lkp_fx_rates.USD_PER_UNIT == null ? java.math.BigDecimal.ONE : lkp_fx_rates.USD_PER_UNIT" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="refund_usd" expression="row_returns.REFUND_AMOUNT.multiply(Var.fx_rate).setScale(2, java.math.RoundingMode.HALF_UP)" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="reason_code" expression="row_returns.REASON_CODE == null ? null : StringHandling.UPCASE(row_returns.REASON_CODE.trim())" type="id_String" nullable="true"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="out_returns" activateExpressionFilter="false" expressionFilter="">
        <mapperTableEntries name="ORDER_LINE_ID" expression="row_returns.ORDER_LINE_ID" type="id_Long" nullable="true"/>
        <mapperTableEntries name="PRODUCT_ID" expression="lkp_order_lines.PRODUCT_ID" type="id_Long" nullable="true"/>
        <mapperTableEntries name="REASON_CODE" expression="Var.reason_code" type="id_String" nullable="true"/>
        <mapperTableEntries name="RETURN_QTY" expression="row_returns.RETURN_QTY" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="REFUND_USD" expression="Var.refund_usd" type="id_BigDecimal" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row_returns" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="RETURN_ID" type="id_Long" nullable="true"/>
        <mapperTableEntries name="ORDER_LINE_ID" type="id_Long" nullable="true"/>
        <mapperTableEntries name="RETURN_DATE" type="id_Date" nullable="true"/>
        <mapperTableEntries name="RETURN_QTY" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="REASON_CODE" type="id_String" nullable="true"/>
        <mapperTableEntries name="REFUND_AMOUNT" type="id_BigDecimal" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="lkp_order_lines" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE" innerJoin="true" activateExpressionFilter="false" expressionFilter="">
        <mapperTableEntries name="ORDER_LINE_ID" type="id_Long" nullable="true" expression="row_returns.ORDER_LINE_ID" operator="="/>
        <mapperTableEntries name="ORDER_ID" type="id_Long" nullable="true"/>
        <mapperTableEntries name="PRODUCT_ID" type="id_Long" nullable="true"/>
        <mapperTableEntries name="QUANTITY" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="UNIT_PRICE" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="DISCOUNT_PCT" type="id_BigDecimal" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="lkp_orders" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE" innerJoin="true" activateExpressionFilter="true" expressionFilter="java.util.Arrays.asList(&quot;COMPLETED&quot;, &quot;SHIPPED&quot;, &quot;RETURNED&quot;).contains(lkp_orders.STATUS == null ? &quot;&quot; : StringHandling.UPCASE(lkp_orders.STATUS.trim()))">
        <mapperTableEntries name="ORDER_ID" type="id_Long" nullable="true" expression="lkp_order_lines.ORDER_ID" operator="="/>
        <mapperTableEntries name="CUSTOMER_ID" type="id_Long" nullable="true"/>
        <mapperTableEntries name="ORDER_DATE" type="id_Date" nullable="true"/>
        <mapperTableEntries name="STATUS" type="id_String" nullable="true"/>
        <mapperTableEntries name="CURRENCY_CODE" type="id_String" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="lkp_customers" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE" innerJoin="true" activateExpressionFilter="true" expressionFilter="!&quot;Y&quot;.equals(lkp_customers.IS_TEST_ACCOUNT == null ? &quot;N&quot; : StringHandling.UPCASE(lkp_customers.IS_TEST_ACCOUNT.trim()))">
        <mapperTableEntries name="CUSTOMER_ID" type="id_Long" nullable="true" expression="lkp_orders.CUSTOMER_ID" operator="="/>
        <mapperTableEntries name="IS_TEST_ACCOUNT" type="id_String" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="lkp_fx_rates" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE" innerJoin="false" activateExpressionFilter="false" expressionFilter="">
        <mapperTableEntries name="CURRENCY_CODE" type="id_String" nullable="true" expression="lkp_orders.CURRENCY_CODE == null ? null : StringHandling.UPCASE(lkp_orders.CURRENCY_CODE.trim())" operator="="/>
        <mapperTableEntries name="RATE_MONTH_KEY" type="id_String" nullable="true" expression="TalendDate.formatDate(&quot;yyyy-MM-01&quot;, lkp_orders.ORDER_DATE)" operator="="/>
        <mapperTableEntries name="USD_PER_UNIT" type="id_BigDecimal" nullable="true"/>
      </inputTables>
    </nodeData>
  </node>

  <node componentName="tNote" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="480" posY="0">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tNote_1"/>
    <elementParameter field="MEMO" name="TEXT" value="J_Product_Returns_Analysis&#10;Owner: Merch Analytics ETL (D. Okafor) | Created 2019-06 | Last change 2023-11&#10;Builds ANALYTICS.LEGACY.PRODUCT_RETURNS_SUMMARY (1 row per product sold on a valid order).&#10;Valid order = status COMPLETED / SHIPPED / RETURNED and customer is not a QA/test account.&#10;Refunds converted to USD at the ORDER month FX rate (not the return month). USD has no row in FX_RATES -&gt; rate 1.&#10;Truncate + reload nightly."/>
  </node>
  <node componentName="tSnowflakeInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="192">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tSnowflakeInput_1"/>

    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="false">
        <mapperTableEntries name="return_rate" expression="row_prod_agg.UNITS_SOLD &gt; 0 ? new java.math.BigDecimal(row_prod_agg.UNITS_RETURNED).divide(new java.math.BigDecimal(row_prod_agg.UNITS_SOLD), 4, java.math.RoundingMode.HALF_UP) : new java.math.BigDecimal(&quot;0.0000&quot;)" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="return_flag" expression="(row_prod_agg.UNITS_SOLD &gt;= 10 &amp;&amp; Var.return_rate.compareTo(new java.math.BigDecimal(&quot;0.15&quot;)) &gt;= 0) ? &quot;HIGH&quot; : (Var.return_rate.compareTo(new java.math.BigDecimal(&quot;0.08&quot;)) &gt;= 0 ? &quot;WATCH&quot; : &quot;NORMAL&quot;)" type="id_String" nullable="true"/>
        <mapperTableEntries name="top_return_reason" expression="lkp_top_reason.REASON_CODE == null ? &quot;NONE&quot; : &quot;DMG&quot;.equals(lkp_top_reason.REASON_CODE) ? &quot;Damaged&quot; : &quot;SIZE&quot;.equals(lkp_top_reason.REASON_CODE) ? &quot;Wrong Size&quot; : &quot;DESC&quot;.equals(lkp_top_reason.REASON_CODE) ? &quot;Not As Described&quot; : &quot;MIND&quot;.equals(lkp_top_reason.REASON_CODE) ? &quot;Changed Mind&quot; : &quot;Other&quot;" type="id_String" nullable="true"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="out_summary" activateExpressionFilter="false" expressionFilter="">
        <mapperTableEntries name="PRODUCT_ID" expression="row_prod_agg.PRODUCT_ID" type="id_Long" nullable="true"/>
        <mapperTableEntries name="SKU" expression="row_prod_agg.SKU" type="id_String" nullable="true"/>
        <mapperTableEntries name="PRODUCT_NAME" expression="row_prod_agg.PRODUCT_NAME" type="id_String" nullable="true"/>
        <mapperTableEntries name="CATEGORY" expression="row_prod_agg.CATEGORY" type="id_String" nullable="true"/>
        <mapperTableEntries name="UNITS_SOLD" expression="row_prod_agg.UNITS_SOLD" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="UNITS_RETURNED" expression="row_prod_agg.UNITS_RETURNED" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="RETURN_RATE" expression="Var.return_rate" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="REFUND_AMOUNT_USD" expression="row_prod_agg.REFUND_AMOUNT_USD.setScale(2, java.math.RoundingMode.HALF_UP)" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="TOP_RETURN_REASON" expression="Var.top_return_reason" type="id_String" nullable="true"/>
        <mapperTableEntries name="RETURN_FLAG" expression="Var.return_flag" type="id_String" nullable="true"/>
        <mapperTableEntries name="ETL_LOAD_TS" expression="TalendDate.getCurrentDate()" type="id_Date" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row_prod_agg" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="PRODUCT_ID" type="id_Long" nullable="true"/>
        <mapperTableEntries name="SKU" type="id_String" nullable="true"/>
        <mapperTableEntries name="PRODUCT_NAME" type="id_String" nullable="true"/>
        <mapperTableEntries name="CATEGORY" type="id_String" nullable="true"/>
        <mapperTableEntries name="UNITS_SOLD" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="UNITS_RETURNED" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="REFUND_AMOUNT_USD" type="id_BigDecimal" nullable="true"/>

    <elementParameter field="CLOSED_LIST" name="MANUAL_QUERY" value="true"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT RETURN_ID, ORDER_LINE_ID, RETURN_DATE, RETURN_QTY, REASON_CODE, REFUND_AMOUNT&#10;FROM &quot; + context.src_database + &quot;.&quot; + context.src_schema + &quot;.RETURNS&quot;"/>
